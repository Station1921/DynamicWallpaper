<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DynamicWallpaper.Web</AssemblyName>
    <RootNamespace>DynamicWallpaper.Providers</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- 网页 / 3D 壁纸依赖 WebView2（Chromium）。首次构建需联网还原此包。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <!-- 复用主程序的接口、渲染窗口与桌面注入逻辑 -->
    <ProjectReference Include="..\DynamicWallpaper.csproj" />
  </ItemGroup>

</Project>
