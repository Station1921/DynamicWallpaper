<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DynamicWallpaper</AssemblyName>
    <RootNamespace>DynamicWallpaper</RootNamespace>
    <AssemblyTitle>动态桌面</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- 原生库自解压：让 WebView2Loader.dll 等非托管库嵌入 exe，运行时由单文件宿主
         自动解压到系统临时目录（%TEMP%\.net\DynamicWallpaper_xxx\）并加载。
         程序目录只保留 exe 单文件，无需外置 WebView2Loader.dll（用户只拷 exe 也能运行）。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>

    <!--
      obj/bin 路径重定向见 Directory.Build.props（必须在 Microsoft.Common.props 导入前设置，
      否则 MSBuildProjectExtensionsPath 会回退到被锁的项目 obj\，导致 MarkupCompile Access Denied）。
    -->

    <!-- 禁用 Roslyn 共享编译服务器，避免其常驻进程锁定 obj 下的 .cache 导致重复构建时报 Access Denied -->
    <UseSharedCompilation>false</UseSharedCompilation>
    <!-- SDK 8.0.4xx 下 wpftmp 临时项目（MarkupCompilePass1）会把主项目 obj 下生成的
         AssemblyAttributes.cs/AssemblyInfo.cs 当作编译源一并包含，触发 CS0579 特性重复。
         关闭自动生成 AssemblyInfo 与 TargetFrameworkAttribute（版本等元数据仍由下方
         AssemblyVersion 等属性声明），规避该问题。 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- hls.js（HLS/m3u8 播放内核）：内嵌进主程序 exe，远程 m3u8 壁纸由 WebProvider
       读取后以 NavigateToString 注入 WebView2 流式播放，无需 CDN 或外置 DLL。
       网页壁纸模块（DynamicWallpaper.Web\WebProvider.cs）现已随主工程一起编译，
       不再作为独立程序集加载。 -->
  <ItemGroup>
    <EmbeddedResource Include="DynamicWallpaper.Web\hls.min.js">
      <LogicalName>hls.min.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 视频壁纸渲染内核：WebView2（Win11 25H2 raised desktop 下 WPF MediaElement 无法被 DWM 合成，
       实验验证 WebView2 内容可被 DWM 真实合成到桌面）。版本 1.0.2592.51 为实验验证版本，禁止降级。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <!-- netbian 等中文壁纸站使用 GBK 编码，.NET 8 默认不支持 GBK，需要 CodePages 提供程序 -->
  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <!-- 程序图标源文件（appicon.ico 通过 ApplicationIcon 作为原生图标嵌入 EXE，
       运行时由 Icon.ExtractAssociatedIcon 取出，用于窗口标题栏与托盘；不再依赖 WPF pack 资源 -->
  <ItemGroup>
    <None Include="Assets\appicon.png" />
  </ItemGroup>

  <!-- ffmpeg 内嵌资源：单文件发布后 exe 自带 ffmpeg，运行时按需解压到程序根目录，
       避免用户移动 exe 后因缺少 ffmpeg.exe 而无法转码 -->
  <ItemGroup>
    <EmbeddedResource Include="ffmpeg.exe">
      <LogicalName>ffmpeg.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 发布时清理伴随文件：单文件发布后仍会输出 .pdb 与引用的 XML 文档，
       对于独立 exe 这些文件无用，发布后自动删除，保持发布目录只有 exe。 -->
  <Target Name="RemoveExtraPublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <ExtraFiles Include="$(PublishDir)*.pdb" />
      <ExtraFiles Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(ExtraFiles)" />
  </Target>

</Project>
