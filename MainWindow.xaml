<Window x:Class="DynamicWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicWallpaper.UI"
        xmlns:models="clr-namespace:DynamicWallpaper.Models"
        Title="动态桌面" Height="680" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#1B1B22"
        AllowDrop="True" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:SizeToClipGeometryConverter x:Key="SizeToClipGeometry"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2A2A33"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4C8DFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#4C8DFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6BA0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearWallpaperBtn" TargetType="Button">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F04A4A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A50F1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8C8D2"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A33"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A33"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="White"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton 铺满整框，点击任意位置都能展开下拉；ContentPresenter 置于其上但禁用命中测试，让点击穿透到 ToggleButton -->
                            <ToggleButton x:Name="DropDownToggle"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Focusable="False" Background="Transparent" BorderThickness="0">
                                <!-- 完全透明模板：屏蔽系统默认 ToggleButton 在 hover/checked 状态绘制的浅色高亮，避免四角白色背景 -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True" IsHitTestVisible="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite" Grid.Column="0"
                                                      Content="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ContentTemplate="{TemplateBinding ItemTemplate}"
                                                      Margin="8,0,2,0"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0 Z" Fill="#C8C8D2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Grid MaxHeight="180" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border Background="#2A2A33" BorderBrush="#3A3A45" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4C8DFF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4C8DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4C8DFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="#3A3A45"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF6B6B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#E01B1B22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True" Background="#E620202A"/>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#8A8A95"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A33"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8C8D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 描边填充分类标签按钮（单选）：未选中透明描边，选中蓝色填充 -->
        <Style x:Key="OutlineChip" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8C8D2"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C8DFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A33"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#6BA0FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 描边分选填充分类标签按钮（复选），与 OutlineChip 视觉效果一致，TargetType 为 CheckBox -->
        <Style x:Key="OutlineChipCheck" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8C8D2"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C8DFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A33"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#6BA0FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：深色主题，宽度 6，与界面主色调一致 -->
        <ControlTemplate x:Key="ThinScrollBarTemplate" TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsEnabled="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="Bd" Background="#4A4A55" CornerRadius="2" SnapsToDevicePixels="True"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#6A6A75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 全局暗色右键菜单：自定义 ControlTemplate 去除默认左侧 accent 竖线与无图标时的 icon 占位，文字靠左，圆角暗色 -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#2A2A33"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="BorderBrush" Value="#3A3A45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项：无 icon 占位（去除默认模板左侧约 26px 空白），悬停蓝色高亮；子菜单 Popup 同样圆角暗色 -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E8E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Margin="1,1"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                    <!-- 子菜单箭头 -->
                                    <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#8A8A95"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,2,0"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- 子菜单弹出层：圆角暗色容器（自动套用 MenuItem 隐式样式） -->
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-3"
                                   AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="#2A2A33" BorderBrush="#3A3A45" BorderThickness="1"
                                        CornerRadius="8" Padding="4" Margin="2" SnapsToDevicePixels="True">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4C8DFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A75"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单分隔符：暗色统一 -->
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3A3A45" Margin="12,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全局隐式样式：窗口内所有 ScrollBar 都变细并默认隐藏 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template" Value="{StaticResource ThinScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="2"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#E61B1B22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="#E620202A" Padding="18,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="动态桌面" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="轻量动态壁纸" FontSize="12" Foreground="#8A8A95" Margin="10,3,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="添加壁纸" Style="{StaticResource PrimaryBtn}" Click="Add_Click" Margin="0,0,8,0"/>
                    <Button Content="网络壁纸" Style="{StaticResource GhostBtn}" Click="AddLink_Click" Margin="0,0,8,0" ToolTip="从网络直链添加壁纸（如视频 .mp4）"/>
                    <Button Content="设置" Style="{StaticResource GhostBtn}" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容：我的壁纸 / netbian.com / mylivewallpapers.com -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Style="{StaticResource TabControlStyle}" ItemContainerStyle="{StaticResource TabItemStyle}" SelectionChanged="MainTabs_SelectionChanged">
            <!-- 我的壁纸 -->
            <TabItem Header="我的壁纸">
                <ScrollViewer x:Name="MyWallpaperScroll" Margin="4,14,4,14" VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <TextBlock Text="壁纸库" FontSize="13" Foreground="#8A8A95" Margin="8,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Library}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:WallpaperItem}">
                                    <Border Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}, Path=CardWidth}" Height="150" Margin="6"
                                            MouseRightButtonUp="Card_RightClick" Cursor="Hand" SnapsToDevicePixels="True"
                                            Style="{StaticResource Card}">
                                        <Grid>
                                            <!-- 把内容裁成与卡片内圆角一致，避免图片/黑底盖住圆角描边，造成"底边两个角被裁"的观感 -->
                                            <Grid.Clip>
                                                <MultiBinding Converter="{StaticResource SizeToClipGeometry}" ConverterParameter="9">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                </MultiBinding>
                                            </Grid.Clip>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Video">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Gif">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <local:MediaHoverImage PosterSource="{Binding Thumbnail}" HoverSourceUri="{Binding Path}" 
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <local:MediaHoverImage.Style>
                                                    <Style TargetType="local:MediaHoverImage">
                                                        <!-- 默认值必须放在 Style Setter 中，不能作为元素直接属性赋值，
                                                             否则 LocalValue 优先级会覆盖 DataTrigger，导致 Video/Gif 卡片永远 Collapsed（灰底）。 -->
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Video">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="Gif">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:MediaHoverImage.Style>
                                            </local:MediaHoverImage>
                                            <!-- 无缩略图封面：网络壁纸使用多彩动态流光封面，普通壁纸使用静态深色底 -->
                                            <Border Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}, ConverterParameter=inverse}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#15151B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnlineUrl}" Value="True">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <!-- 普通壁纸：静态类型标签 -->
                                                    <TextBlock Foreground="#6A6A75" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding TypeLabel}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnlineUrl}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- 网络壁纸：弥散流体 Aurora 封面 -->
                                                    <Border Visibility="{Binding IsOnlineUrl, Converter={StaticResource BoolToVisibility}}"
                                                            ClipToBounds="True">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" SpreadMethod="Repeat">
                                                                <GradientStop Color="#0B1020" Offset="0"/>
                                                                <GradientStop Color="#121A33" Offset="0.35"/>
                                                                <GradientStop Color="#1A2744" Offset="0.65"/>
                                                                <GradientStop Color="#0B1020" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Background.GradientStops[0].Offset" From="0" To="1" Duration="0:0:3.5"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Background.GradientStops[1].Offset" From="0.35" To="1.35" Duration="0:0:3.5"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Background.GradientStops[2].Offset" From="0.65" To="1.65" Duration="0:0:3.5"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Background.GradientStops[3].Offset" From="1" To="2" Duration="0:0:3.5"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>

                                                        <Grid ClipToBounds="True">
                                                            <!-- 弥散流体 blob 层：多个模糊彩色椭圆漂移/呼吸，入场先渐入避免闪烁 -->
                                                            <!-- Blob 1：左上蓝紫 -->
                                                            <Ellipse Width="150" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-50,-40,0,0" IsHitTestVisible="False" Opacity="0">
                                                                <Ellipse.Fill>
                                                                    <RadialGradientBrush>
                                                                <GradientStop Color="#E54C8DFF" Offset="0"/>
                                                                <GradientStop Color="#75A855F7" Offset="0.55"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                                    </RadialGradientBrush>
                                                                </Ellipse.Fill>
                                                                <Ellipse.Effect>
                                                                    <BlurEffect Radius="55"/>
                                                                </Ellipse.Effect>
                                                                <Ellipse.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform/>
                                                                        <ScaleTransform CenterX="75" CenterY="75"/>
                                                                    </TransformGroup>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.85" Duration="0:0:1.5" BeginTime="0:0:0"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].X" From="-20" To="35" Duration="0:0:4.5" BeginTime="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].Y" From="-15" To="30" Duration="0:0:5.5" BeginTime="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX" From="0.9" To="1.15" Duration="0:0:3.5" BeginTime="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleY" From="0.9" To="1.15" Duration="0:0:3.5" BeginTime="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.85" To="1" Duration="0:0:2.5" BeginTime="0:0:1.2" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>

                                                            <!-- Blob 2：右下粉青 -->
                                                            <Ellipse Width="170" Height="170" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-50" IsHitTestVisible="False" Opacity="0">
                                                                <Ellipse.Fill>
                                                                    <RadialGradientBrush>
                                                                <GradientStop Color="#F0EC4899" Offset="0"/>
                                                                <GradientStop Color="#A006B6D4" Offset="0.55"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                                    </RadialGradientBrush>
                                                                </Ellipse.Fill>
                                                                <Ellipse.Effect>
                                                                    <BlurEffect Radius="60"/>
                                                                </Ellipse.Effect>
                                                                <Ellipse.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform/>
                                                                        <ScaleTransform CenterX="85" CenterY="85"/>
                                                                    </TransformGroup>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.8" Duration="0:0:1.6" BeginTime="0:0:0.4"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].X" From="25" To="-40" Duration="0:0:5" BeginTime="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].Y" From="20" To="-35" Duration="0:0:4.5" BeginTime="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX" From="1.0" To="1.25" Duration="0:0:3.5" BeginTime="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleY" From="1.0" To="1.25" Duration="0:0:3.5" BeginTime="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.8" To="1" Duration="0:0:2.5" BeginTime="0:0:1.6" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>

                                                            <!-- Blob 3：中部青蓝 -->
                                                            <Ellipse Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,-30,-40,30" IsHitTestVisible="False" Opacity="0">
                                                                <Ellipse.Fill>
                                                                    <RadialGradientBrush>
                                                                <GradientStop Color="#D006B6D4" Offset="0"/>
                                                                <GradientStop Color="#704C8DFF" Offset="0.55"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                                    </RadialGradientBrush>
                                                                </Ellipse.Fill>
                                                                <Ellipse.Effect>
                                                                    <BlurEffect Radius="50"/>
                                                                </Ellipse.Effect>
                                                                <Ellipse.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform/>
                                                                        <ScaleTransform CenterX="65" CenterY="65"/>
                                                                    </TransformGroup>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.75" Duration="0:0:1.7" BeginTime="0:0:0.8"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].X" From="-30" To="30" Duration="0:0:5.5" BeginTime="0:0:1.7" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].Y" From="20" To="-25" Duration="0:0:5" BeginTime="0:0:1.7" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX" From="0.85" To="1.2" Duration="0:0:3.5" BeginTime="0:0:1.7" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleY" From="0.85" To="1.2" Duration="0:0:3.5" BeginTime="0:0:1.7" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.75" To="0.95" Duration="0:0:2.5" BeginTime="0:0:1.7" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>

                                                            <!-- Blob 4：底部紫色柔光 -->
                                                            <Ellipse Width="120" Height="120" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,-30" IsHitTestVisible="False" Opacity="0">
                                                                <Ellipse.Fill>
                                                                    <RadialGradientBrush>
                                                                <GradientStop Color="#D8A855F7" Offset="0"/>
                                                                <GradientStop Color="#90EC4899" Offset="0.55"/>
                                                                <GradientStop Color="#00000000" Offset="1"/>
                                                                    </RadialGradientBrush>
                                                                </Ellipse.Fill>
                                                                <Ellipse.Effect>
                                                                    <BlurEffect Radius="48"/>
                                                                </Ellipse.Effect>
                                                                <Ellipse.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform/>
                                                                        <ScaleTransform CenterX="60" CenterY="60"/>
                                                                    </TransformGroup>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.65" Duration="0:0:1.8" BeginTime="0:0:1.2"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].X" From="15" To="-25" Duration="0:0:5" BeginTime="0:0:1.8" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[0].Y" From="-20" To="15" Duration="0:0:5.5" BeginTime="0:0:1.8" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX" From="0.9" To="1.15" Duration="0:0:4" BeginTime="0:0:1.8" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].ScaleY" From="0.9" To="1.15" Duration="0:0:4" BeginTime="0:0:1.8" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.65" To="0.9" Duration="0:0:3" BeginTime="0:0:1.8" RepeatBehavior="Forever" AutoReverse="True"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>

                                                            <!-- 柔化覆盖层：让 blob 边缘更弥散，尽量少压暗颜色 -->
                                                            <Border Background="#06000000" IsHitTestVisible="False"/>

                                                            <!-- 中心光晕 -->
                                                            <Ellipse Width="110" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-8,0,0" IsHitTestVisible="False" Opacity="0.75">
                                                                <Ellipse.Fill>
                                                                    <RadialGradientBrush>
                                                                        <GradientStop Color="#85FFFFFF" Offset="0"/>
                                                                        <GradientStop Color="#404C8DFF" Offset="0.5"/>
                                                                        <GradientStop Color="#00000000" Offset="1"/>
                                                                    </RadialGradientBrush>
                                                                </Ellipse.Fill>
                                                                <Ellipse.Effect>
                                                                    <BlurEffect Radius="35"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>

                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                                                                <TextBlock Text="网络" FontSize="15" FontWeight="SemiBold" Foreground="#F0F4FF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect Color="#4C8DFF" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                                <TextBlock Text="Online" FontSize="9" Foreground="#A8B8E8" Margin="0,4,0,0" HorizontalAlignment="Center" Opacity="0.9"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 已应用到的屏幕徽标 -->
                                            <Border Background="#4C8DFF" CornerRadius="4" Padding="6,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                    Visibility="{Binding ActiveScreens, Converter={StaticResource StringToVisibility}}">
                                                <TextBlock Text="{Binding ActiveScreens}" Foreground="White" FontSize="10"/>
                                            </Border>

                                            <!-- 动态/静态/网络标签 -->
                                            <Border CornerRadius="4" Padding="6,2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#CC000000"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnlineUrl}" Value="True">
                                                                <Setter Property="Background" Value="#CCE91E63"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Foreground="White" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding MotionLabel}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnlineUrl}" Value="True">
                                                                    <Setter Property="Text" Value="网络"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8" CornerRadius="0,0,9,9">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="设为壁纸" Style="{StaticResource PrimaryBtn}"
                                                            Padding="10,4" FontSize="11" Click="SetWallpaper_Click"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}"/>
                                                    <Button Content="解除" Style="{StaticResource DangerBtn}"
                                                            Padding="10,4" FontSize="11" Click="ClearWallpaper_Click"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 网络壁纸流光边框：独立覆盖层，仅在线壁纸显示。
                                                 其 BorderBrush 为直接元素属性（不会被 Style/Setter 冻结），用 EventTrigger 做流光，安全无崩溃。 -->
                                            <Border Grid.ZIndex="5" BorderThickness="2" CornerRadius="9"
                                                    IsHitTestVisible="False" SnapsToDevicePixels="True">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" SpreadMethod="Repeat">
                                                        <GradientStop Color="#4C8DFF" Offset="0"/>
                                                        <GradientStop Color="#A855F7" Offset="0.25"/>
                                                        <GradientStop Color="#EC4899" Offset="0.5"/>
                                                        <GradientStop Color="#06B6D4" Offset="0.75"/>
                                                        <GradientStop Color="#4C8DFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnlineUrl}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="BorderBrush.GradientStops[0].Offset" From="0" To="1" Duration="0:0:3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="BorderBrush.GradientStops[1].Offset" From="0.25" To="1.25" Duration="0:0:3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="BorderBrush.GradientStops[2].Offset" From="0.5" To="1.5" Duration="0:0:3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="BorderBrush.GradientStops[3].Offset" From="0.75" To="1.75" Duration="0:0:3"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="BorderBrush.GradientStops[4].Offset" From="1" To="2" Duration="0:0:3"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="EmptyHint" Background="#E620202A" BorderBrush="#3A3A45" BorderThickness="1"
                                CornerRadius="10" Padding="30" Margin="8,16,8,6" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="还没有壁纸" Foreground="#8A8A95" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="拖拽视频 / 图片到窗口，或点击右上角「添加壁纸」" Foreground="#6A6A75" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 静态壁纸（netbian.com） -->
            <TabItem Header="静态壁纸">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 分类标签栏 -->
                    <Border Grid.Row="0" Background="#E620202A" Padding="12,8">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="CategoryScroll_PreviewMouseWheel">
                            <StackPanel x:Name="NetbianCategoryPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 在线壁纸网格 -->
                    <ScrollViewer x:Name="NetbianScroll" Grid.Row="1" Margin="4,14,4,0" VerticalScrollBarVisibility="Hidden" ScrollChanged="NetbianScroll_ScrollChanged">
                        <StackPanel>
                            <ItemsControl x:Name="NetbianItems" ItemsSource="{Binding NetbianWallpapers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Margin="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OnlineWallpaperItem}">
                                        <Border Style="{StaticResource Card}" Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}, Path=CardWidth}" Height="150" Margin="6" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.Clip>
                                                    <MultiBinding Converter="{StaticResource SizeToClipGeometry}" ConverterParameter="9">
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </Grid.Clip>
                                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8" CornerRadius="0,0,9,9">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="下载" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineDownload_Click"
                                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}"/>
                                                        <Button Content="设为桌面" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineDownload_Click"
                                                                Visibility="{Binding ShowSetDesktop, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Button Content="解除壁纸" Style="{StaticResource ClearWallpaperBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineClearWallpaper_Click"
                                                                Visibility="{Binding ShowClearDesktop, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="NetbianEmptyHint" Background="#E620202A" BorderBrush="#3A3A45" BorderThickness="1" CornerRadius="10" Padding="30" Margin="8,16,8,6" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="暂无在线壁纸" Foreground="#8A8A95" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="选择上方分类标签自动加载" Foreground="#6A6A75" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Wallhaven（wallhaven.cc，在线壁纸 toplist） -->
            <TabItem Header="Wallhaven">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 分类标签栏 -->
                    <Border Grid.Row="0" Background="#E620202A" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="CategoryScroll_PreviewMouseWheel" VerticalAlignment="Center">
                                <StackPanel x:Name="GBizhiCategoryPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="分辨率" Foreground="#8A8A95" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="WallhavenResolutionCombo" Style="{StaticResource Combo}" ItemContainerStyle="{StaticResource ComboItem}" Width="128" SelectionChanged="WallhavenResolution_Changed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 在线壁纸网格 -->
                    <ScrollViewer x:Name="GBizhiScroll" Grid.Row="1" Margin="4,14,4,0" VerticalScrollBarVisibility="Hidden" ScrollChanged="GBizhiScroll_ScrollChanged">
                        <StackPanel>
                            <ItemsControl x:Name="GBizhiItems" ItemsSource="{Binding GBizhiWallpapers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Margin="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OnlineWallpaperItem}">
                                        <Border Style="{StaticResource Card}" Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}, Path=CardWidth}" Height="150" Margin="6" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.Clip>
                                                    <MultiBinding Converter="{StaticResource SizeToClipGeometry}" ConverterParameter="9">
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </Grid.Clip>
                                                <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8" CornerRadius="0,0,9,9">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="下载" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineDownload_Click"
                                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}"/>
                                                        <Button Content="设为桌面" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineDownload_Click"
                                                                Visibility="{Binding ShowSetDesktop, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Button Content="解除壁纸" Style="{StaticResource ClearWallpaperBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineClearWallpaper_Click"
                                                                Visibility="{Binding ShowClearDesktop, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="GBizhiEmptyHint" Background="#E620202A" BorderBrush="#3A3A45" BorderThickness="1" CornerRadius="10" Padding="30" Margin="8,16,8,6" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="暂无在线壁纸" Foreground="#8A8A95" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="选择上方分类标签自动加载" Foreground="#6A6A75" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 动态壁纸（3gbizhi deskDT 高清 MP4 视频壁纸） -->
            <TabItem Header="动态壁纸">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 在线壁纸网格 -->
                    <ScrollViewer x:Name="DynamicScroll" Grid.Row="0" Margin="4,14,4,0" VerticalScrollBarVisibility="Hidden" ScrollChanged="DynamicScroll_ScrollChanged">
                        <StackPanel>
                            <ItemsControl x:Name="DynamicItems" ItemsSource="{Binding DynamicWallpapers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" Margin="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:OnlineWallpaperItem}">
                                        <Border Style="{StaticResource Card}" Width="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Window}, Path=CardWidth}" Height="150" Margin="6" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.Clip>
                                                    <MultiBinding Converter="{StaticResource SizeToClipGeometry}" ConverterParameter="9">
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                                    </MultiBinding>
                                                </Grid.Clip>
                                                <local:MediaHoverImage SourceUri="{Binding ThumbnailUrl}" HoverSourceUri="{Binding PreviewUrl}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8" CornerRadius="0,0,9,9">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="下载" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineDownload_Click"
                                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}, ConverterParameter=inverse}"/>
                                                        <Button Content="设为桌面" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineDownload_Click"
                                                                Visibility="{Binding ShowSetDesktop, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Button Content="解除壁纸" Style="{StaticResource ClearWallpaperBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Center" Click="OnlineClearWallpaper_Click"
                                                                Visibility="{Binding ShowClearDesktop, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="DynamicEmptyHint" Background="#E620202A" BorderBrush="#3A3A45" BorderThickness="1" CornerRadius="10" Padding="30" Margin="8,16,8,6" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="暂无在线壁纸" Foreground="#8A8A95" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="向下滚动加载更多动态壁纸" Foreground="#6A6A75" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部统一状态栏：左侧全局状态，竖直分割线，右侧加载操作 -->
        <Border Grid.Row="2" Background="#E620202A" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：全局状态显示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock x:Name="StatusText" Text="当前：无" Foreground="#C8C8D2" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ScreenLabel" Text="屏幕" Foreground="#8A8A95" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ScreenText" Text="主屏" Foreground="#C8C8D2" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <ComboBox x:Name="ScreenCombo" Style="{StaticResource Combo}" ItemContainerStyle="{StaticResource ComboItem}" Width="110" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>

                <!-- 竖直分割线 -->
                <Border Grid.Column="1" Width="1" Background="#3A3A45" Margin="8,1,8,1"/>

                <!-- 右侧：加载操作（按页签切换可见） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MyWallpaperCount" Text="共 0 个" Foreground="#8A8A95" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <TextBlock x:Name="NetbianStatus" Text="选择分类后自动加载" Foreground="#8A8A95" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="GBizhiStatus" Text="选择分类后自动加载" Foreground="#8A8A95" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>

                    <TextBlock x:Name="DynamicStatus" Text="正在加载动态壁纸..." Foreground="#8A8A95" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
