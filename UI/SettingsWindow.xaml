<Window x:Class="DynamicWallpaper.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="380" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1B1B22"
        Foreground="White">

    <StackPanel Margin="22">
        <TextBlock Text="设置" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,18"/>

        <CheckBox x:Name="MuteBox" Content="视频壁纸静音" Foreground="#D8D8E0" Margin="0,0,0,12" Checked="Mute_Changed" Unchecked="Mute_Changed"/>
        <CheckBox x:Name="FsBox" Content="前台全屏时自动暂停" Foreground="#D8D8E0" Margin="0,0,0,12" Checked="Fs_Changed" Unchecked="Fs_Changed"/>
        <CheckBox x:Name="BatBox" Content="使用电池时自动暂停" Foreground="#D8D8E0" Margin="0,0,0,12" Checked="Bat_Changed" Unchecked="Bat_Changed"/>
        <CheckBox x:Name="PerfBox" Content="性能模式（降低壁纸优先级与画质，减少游戏/前台卡顿）" Foreground="#D8D8E0" Margin="0,0,0,12" Checked="Perf_Changed" Unchecked="Perf_Changed"/>
        <CheckBox x:Name="StartBox" Content="开机自启" Foreground="#D8D8E0" Margin="0,0,0,12" Checked="Start_Changed" Unchecked="Start_Changed"/>
        <CheckBox x:Name="TrayBox" Content="点击关闭时最小化到托盘（不勾选则关闭直接退出）" Foreground="#D8D8E0" Margin="0,0,0,12" Checked="Tray_Changed" Unchecked="Tray_Changed"/>

        <TextBlock Text="提示：壁纸渲染在桌面图标之后，自动暂停可释放 GPU/CPU。" Foreground="#7A7A85" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
