<Window x:Class="DynamicWallpaper.UI.TranscodeProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在转码" Height="170" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B22" Foreground="White"
        ShowInTaskbar="False" Topmost="True" WindowStyle="ToolWindow"
        SourceInitialized="OnSourceInitialized">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="FileText" FontSize="13" Foreground="#D8D8E0" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>
        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Background="#2A2A33" Foreground="#4C8DFF"/>
        <TextBlock x:Name="StatusText" FontSize="11" Foreground="#8A8A95" Margin="0,10,0,0" Text="正在准备…"/>
    </StackPanel>
</Window>
